# Makevars.win — Windows counterpart of the configure-generated src/Makevars.
# Windows has no ./configure (R does not run it there), so this is committed and
# static. It compiles the SAME bundled vendor/ tree the CRAN source tarball
# ships (populated on Unix by ./configure, shipped inside the tarball). Rtools'
# make is GNU make and Rtools provides `find`, so the $(shell find ...) recursion
# matches src/Makevars exactly.
#
# Fortran-free build: N4M_HAVE_FITPACK=0 selects the pure-C Reinsch cubic
# smoothing-spline fallback in spline_smoothing.c. The tarball ships no .f
# sources, so nothing here compiles Fortran (no gfortran, no -std=legacy).
# n4m_aug_spline_smooth still performs real smoothing.

PKG_CPPFLAGS = -Ivendor/cpp/include -Ivendor/cpp/src -Ivendor/generated \
               -DN4M_STATIC=1 -DN4M_HAVE_FITPACK=0

CXX_STD = CXX17

VEND_C   := $(shell find vendor -name '*.c')
# cuda_dispatch.cpp is the CUDA backend (needs cuBLAS); excluded from the
# reference build, exactly as the CMake build gates it behind N4M_USE_CUDA.
VEND_CPP := $(shell find vendor -name '*.cpp' ! -name 'cuda_dispatch.cpp')
R_OBJ    := r_init.o r_gateway.o r_dispatch.o r_methods.o r_preprocessing.o n4m_cxx.o

OBJECTS = $(R_OBJ) $(VEND_C:.c=.o) $(VEND_CPP:.cpp=.o)
