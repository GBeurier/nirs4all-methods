#!/bin/sh
# Generate src/Makevars.win (Windows runs configure.win before compiling). It
# compiles the vendored libn4m tree the source tarball ships (populated by
# ./configure on Unix), exactly as the Unix src/Makevars does. The flags live
# here rather than in a committed Makevars.win: no FMA contraction, so Windows
# (clang on arm64) returns the same bits as every other n4m binding.
cat > src/Makevars.win <<'MK'
# GENERATED by ./configure.win — self-contained static build of the vendored core.
PKG_CPPFLAGS = -Ivendor/cpp/include -Ivendor/cpp/src -Ivendor/generated \
               -DN4M_STATIC=1
PKG_CFLAGS = -ffp-contract=off
PKG_CXXFLAGS = -ffp-contract=off
CXX_STD = CXX17

VEND_C   := $(shell find vendor -name '*.c')
# cuda_dispatch.cpp is the CUDA backend (needs cuBLAS); excluded from the
# reference build, exactly as the CMake build gates it behind N4M_USE_CUDA.
VEND_CPP := $(shell find vendor -name '*.cpp' ! -name 'cuda_dispatch.cpp')
R_OBJ    := $(patsubst %.c,%.o,$(wildcard r_*.c)) n4m_cxx.o

OBJECTS = $(R_OBJ) $(VEND_C:.c=.o) $(VEND_CPP:.cpp=.o)
MK
