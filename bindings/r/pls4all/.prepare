#!/bin/sh
# R-universe pre-build hook.
#
# R-universe's build backend (r-universe-org/build-source) clones the WHOLE
# monorepo and runs this script from the package directory BEFORE `R CMD build`,
# while the full tree — including the top-level `cpp/` core at ../../../cpp — is
# still on disk. That is the only window in which the out-of-tree libn4m sources
# are reachable, so we vendor them here (exactly the step the CRAN CI runs).
#
# `N4M_R_VENDOR=1 ./configure` copies the C/C++/Fortran core into src/vendor/.
# `R CMD build` then bundles src/vendor/ into the source tarball, so every later
# step (the tarball's own configure on install, and the Windows/macOS binary
# builds via src/Makevars.win) compiles a self-contained n4m.so with no external
# libn4m and no need for the parent repo. See docs/dev/release_process.md.
set -e
N4M_R_VENDOR=1 ./configure
